#!/usr/bin/env python3
"""Join the notes scratch dirs, their session metadata, and the knowledge base
into one index.

The knowledge base at $NOTES_KB is the curated routing table: `index.md` holds a
one-line hook per topic, each `topics/<slug>.md` holds frontmatter aliases and a
`**Scratch:**` line pointing at the scratch dirs that fed it. None of that was
reachable from the shell, so `notes <query>` could only match directory names.
This script makes it reachable.

Nothing here writes. It reads the KB, reads `.session.json` where present, and
falls back to the KB's own `**Scratch:**` pointers for the dirs that predate
session metadata -- so the index is complete without a migration.

Modes:
  --fzf     tab-separated rows for the notes(1) picker:
              <display>\t<value>
            where <value> is a dir slug, or `+topic:<slug>` meaning "new dir
            tagged to this topic".

            Everything searchable has to live in <display>: fzf matches against
            the line as transformed by --with-nth, so a trailing hidden field is
            invisible to the matcher. That is why aliases are a visible column
            rather than tucked away -- `notes playcount` has to be able to find
            a topic whose alias is GetEpisodePlayCount.
  --json    the whole index, for wip(1), notes-gc(1), and slash commands.
  --redirects  `<old-slug>\t<current-slug>` for dirs absorbed by a merge.
  --clusters   candidate merges, grouped by shared knowledge base topic.

Env: NOTES_DIR (default ~/workspace/_notes)
     NOTES_KB  (default ~/workspace/notes-kb)
"""

import json
import os
import re
import sys
import time
from pathlib import Path

HOME = Path.home()
NOTES_DIR = Path(os.environ.get("NOTES_DIR", HOME / "workspace/_notes"))
NOTES_KB = Path(os.environ.get("NOTES_KB", HOME / "workspace/notes-kb"))
PROJECTS_DIR = HOME / ".claude/projects"

# Scratch dirs that are not investigations.
SKIP_DIRS = {"reviews"}

# Top-level dir for investigations with no knowledge base topic yet. Laid out
# like a topic dir; /wrap moves each one out once it knows where it belongs.
INBOX = "inbox"

PRUNE = {"node_modules", ".git", ".venv", "__pycache__", "target", "dist"}
MAX_DEPTH = 2

STOPWORDS = {
    "the", "a", "an", "and", "or", "of", "in", "to", "for", "is", "are", "on",
    "with", "why", "how", "what", "it", "its", "this", "that", "not", "no",
    "was", "were", "be", "been", "from", "at", "by", "as", "but", "we", "you",
}


def transcript_dir_for(rel):
    """The Claude Code project dir that holds a scratch dir's transcripts.

    `rel` is the path under NOTES_DIR: `<slug>` for a top-level dir,
    `<topic>/<slug>` for an investigation inside a topic dir. Claude Code
    encodes a project path by replacing /, _ and . with '-'.

    The name is derived from the path, so it does NOT follow a dir that gets
    moved or merged. That is why a merge has to record it as provenance --
    see notes-merge(1)."""
    encoded = re.sub(r"[/_.]", "-", str(NOTES_DIR / rel).lstrip("/"))
    return "-" + encoded


def transcript_stats():
    """project dir name -> (jsonl count, total KB, newest mtime). Sessions
    whose only artifact is the transcript still count as activity.

    Keyed by the encoded dir name rather than decoded back to a slug: once
    dirs nest, `topic-slug` cannot be split back into `topic/slug`, so callers
    look up the name they expect with transcript_dir_for()."""
    out = {}
    if not PROJECTS_DIR.is_dir():
        return out
    prefix = transcript_dir_for("")
    for entry in os.scandir(PROJECTS_DIR):
        if not entry.is_dir() or not entry.name.startswith(prefix):
            continue
        count = 0
        total = 0
        newest = 0.0
        for f in os.scandir(entry.path):
            if not f.name.endswith(".jsonl"):
                continue
            st = f.stat()
            count += 1
            total += st.st_size
            newest = max(newest, st.st_mtime)
        if count:
            out[entry.name] = (count, total // 1024, newest)
    return out


def walk_dir(path, max_depth=MAX_DEPTH):
    """(file count, md count, newest mtime) under path, pruned and depth-capped.
    `_notes/` holds vendored node_modules; a naive walk is unusably slow.
    max_depth=0 counts only the files directly in path -- what a topic dir's
    root holds, as opposed to its investigations."""
    files = mds = 0
    newest = 0.0
    stack = [(path, 0)]
    while stack:
        current, depth = stack.pop()
        try:
            entries = list(os.scandir(current))
        except OSError:
            continue
        for e in entries:
            if e.is_dir(follow_symlinks=False):
                if e.name not in PRUNE and depth < max_depth:
                    stack.append((e.path, depth + 1))
                continue
            if e.name in (".DS_Store", ".session.json"):
                continue
            try:
                st = e.stat()
            except OSError:
                continue
            files += 1
            if e.name.endswith(".md"):
                mds += 1
            newest = max(newest, st.st_mtime)
    return files, mds, newest


def parse_frontmatter(text):
    """Return the raw YAML frontmatter block, or ''. Not a YAML parser -- the KB
    only uses flat `key: value` and inline lists."""
    if not text.startswith("---"):
        return ""
    end = text.find("\n---", 3)
    return text[3:end] if end != -1 else ""


def parse_inline_list(value):
    value = value.strip()
    if value.startswith("[") and value.endswith("]"):
        value = value[1:-1]
    return [v.strip().strip('"').strip("'") for v in value.split(",") if v.strip()]


def parse_scratch(text):
    """Scratch dirs from the `**Scratch:**` block only.

    The block is one line plus any continuation lines up to the next blank line
    (CONVENTIONS allows it to wrap). Scanning the whole file instead would map
    any dir a topic merely *mentions* -- which silently mis-routed
    `analytics-episode-calls` to `monorepo-migration`."""
    lines = text.splitlines()
    block = []
    for i, line in enumerate(lines):
        if not line.startswith("**Scratch:**"):
            continue
        block.append(line)
        for cont in lines[i + 1:]:
            if not cont.strip() or cont.startswith(("**", "#", "---")):
                break
            block.append(cont)
        break

    text = " ".join(block)
    scratch = []
    # `_notes/<topic>/<slug>/` is one investigation; a path that runs on past
    # that (`.../docs/file.md`) still points at the investigation it is in.
    for m in re.finditer(r"_notes/([A-Za-z0-9._-]+)(?:/([A-Za-z0-9._-]+)/)?", text):
        top = m.group(1).rstrip(".")
        if top in SKIP_DIRS:
            continue
        d = "{}/{}".format(top, m.group(2)) if m.group(2) else top
        if d not in scratch:
            scratch.append(d)
    # Since the reorg a topic's own investigations are listed by name only:
    # **Scratch:** `~/workspace/_notes/<topic>/` — subdirs `a/`, `b/`
    subdirs = [s for s in re.findall(r"`([A-Za-z0-9._-]+)/`", text)]
    return scratch, subdirs


def read_kb():
    """topics: slug -> {hook, aliases, tags, scratch, updated}"""
    topics = {}

    index = NOTES_KB / "index.md"
    hooks = {}
    if index.is_file():
        for line in index.read_text(encoding="utf-8", errors="replace").splitlines():
            # - [[slug]] — hook   /   - [Title](topics/slug.md) — hook
            m = re.match(r"\s*-\s*\[\[([^\]]+)\]\]\s*[—-]?\s*(.*)", line)
            if not m:
                m = re.match(r"\s*-\s*\[[^\]]*\]\(topics/([^).]+)\.md\)\s*[—-]?\s*(.*)", line)
            if m:
                hooks[m.group(1).strip()] = m.group(2).strip()

    topics_dir = NOTES_KB / "topics"
    if topics_dir.is_dir():
        for f in sorted(topics_dir.glob("*.md")):
            slug = f.stem
            text = f.read_text(encoding="utf-8", errors="replace")
            fm = parse_frontmatter(text)
            aliases, tags, updated = [], [], ""
            for line in fm.splitlines():
                if line.startswith("aliases:"):
                    aliases = parse_inline_list(line.split(":", 1)[1])
                elif line.startswith("tags:"):
                    tags = parse_inline_list(line.split(":", 1)[1])
                elif line.startswith("updated:"):
                    updated = line.split(":", 1)[1].strip()

            scratch, subdirs = parse_scratch(text)

            # Fall back to the first prose line when the index has no hook.
            hook = hooks.get(slug, "")
            if not hook:
                for line in text.splitlines():
                    if line.startswith("**What this is:**"):
                        hook = line.replace("**What this is:**", "").strip()
                        break

            topics[slug] = {
                "hook": hook,
                "aliases": aliases,
                "tags": tags,
                "scratch": scratch,
                "subdirs": subdirs,
                "updated": updated,
            }

    # A topic can be listed in index.md before its file exists.
    for slug, hook in hooks.items():
        topics.setdefault(slug, {
            "hook": hook, "aliases": [], "tags": [], "scratch": [],
            "subdirs": [], "updated": "",
        })

    return topics


def read_session(dir_path):
    f = dir_path / ".session.json"
    if not f.is_file():
        return {}
    try:
        data = json.loads(f.read_text(encoding="utf-8"))
        return data if isinstance(data, dict) else {}
    except (json.JSONDecodeError, OSError):
        return {}


def strip_markup(text):
    """Flatten a KB hook into bare words for matching."""
    text = re.sub(r"\[\[([^\]]+)\]\]", r"\1", text)
    text = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"[`*_#|]", " ", text)
    return text


def keywords(*parts):
    words = []
    seen = set()
    for part in parts:
        if not part:
            continue
        for w in re.split(r"[^A-Za-z0-9]+", strip_markup(str(part)).lower()):
            if len(w) < 2 or w in STOPWORDS or w in seen:
                continue
            seen.add(w)
            words.append(w)
    return words


def age_label(mtime, now):
    if not mtime:
        return "-"
    days = int((now - mtime) // 86400)
    if days <= 0:
        return "today"
    if days == 1:
        return "1d"
    if days < 14:
        return f"{days}d"
    if days < 60:
        return f"{days // 7}w"
    return f"{days // 30}mo"


def build():
    now = time.time()
    topics = read_kb()
    transcripts = transcript_stats()

    # dir -> [topics], from the KB's own Scratch pointers. This is what lets the
    # index cover dirs that have no .session.json yet. One scratch dir routinely
    # feeds several topics (mp-in-udl feeds four), so this is a list.
    dir_topic = {}
    for slug in sorted(topics):
        for d in topics[slug]["scratch"]:
            dir_topic.setdefault(d, []).append(slug)

    def row(rel, path, kind, parent="", absorbed_as=None, listed=False):
        """One index row. `rel` is the path under NOTES_DIR and doubles as the
        row's slug, so `_notes/<slug>` stays a valid path for every caller.

        kind: topic         a topic dir's root (`<topic>/`)
              investigation  a dir inside a topic dir (`<topic>/<slug>/`)
              dir            a top-level dir not (yet) under a topic"""
        session = read_session(path)
        files, mds, newest = walk_dir(path, 0 if kind == "topic" else MAX_DEPTH)

        # Its own transcripts, plus those it was absorbed from: a transcript
        # stays named after the path it was opened at, so a moved dir's
        # history lives under its old name.
        tdirs = [transcript_dir_for(rel)]
        tdirs += [a.get("transcript_dir") for a in [absorbed_as] if a]
        tc = tkb = 0
        tmtime = 0.0
        for name in tdirs:
            c, k, m = transcripts.get(name or "", (0, 0, 0.0))
            tc, tkb, tmtime = tc + c, tkb + k, max(tmtime, m)
        last = max(newest, tmtime, path.stat().st_mtime)

        kb_topics = dir_topic.get(rel, [])
        # Topics that actually point here -- a Scratch path, or a topic dir's
        # Scratch line naming this subdir. Unlike `topics`, which a nested dir
        # inherits from the topic dir it sits in, this is what notes-gc must
        # check before deleting anything.
        kb_refs = list(kb_topics)
        if parent and path.name in topics.get(parent, {}).get("subdirs", []) \
                and parent not in kb_refs and kind == "investigation":
            kb_refs.append(parent)
        # Freshest topic first, so the primary slot is the one still active.
        topic_list = sorted(
            kb_topics, key=lambda t: topics[t].get("updated", ""), reverse=True
        )
        # The topic dir a dir lives in is the strongest signal, then what
        # .session.json declared at routing time, then the KB's pointers.
        for t in [session.get("topic"), parent if parent in topics else ""]:
            if t:
                topic_list = [t] + [x for x in topic_list if x != t]

        # A dir the KB points at has been distilled, even with no metadata.
        # An investigation's own .session.json is trusted when it has one.
        # One moved in without metadata predates .session.json and was
        # distilled before it moved -- unless it holds no files, in which case
        # its transcript is all there is and nothing was ever written up.
        wrapped_at = session.get("wrapped_at") or ""
        if "wrapped_at" in session:
            wrapped = bool(wrapped_at) or bool(kb_topics)
        else:
            wrapped = bool(kb_topics) or ((bool(absorbed_as) or listed) and files > 0)

        dirs.append({
            "slug": rel,
            "name": path.name,
            "kind": kind,
            "parent": parent,
            "path": str(path),
            "topic": topic_list[0] if topic_list else "",
            "topics": topic_list,
            "kb_refs": kb_refs,
            "question": session.get("question", ""),
            "wrapped": wrapped,
            "wrapped_at": wrapped_at,
            "worktrees": session.get("worktrees", []),
            "has_session_json": bool(session),
            "files": files,
            "md": mds,
            "transcripts": tc,
            "transcript_kb": tkb,
            "transcript_dir": transcript_dir_for(rel),
            # Slugs merged into this dir. Their transcripts keep their old
            # names forever, so this is the only way back to them.
            "absorbed": session.get("absorbed", []),
            "absorbed_as": (absorbed_as or {}).get("slug", ""),
            "last_activity": int(last),
            "age": age_label(last, now),
            "empty": files == 0,
        })

    dirs = []
    seen_dirs = set()
    if NOTES_DIR.is_dir():
        for entry in sorted(os.scandir(NOTES_DIR), key=lambda e: e.name):
            if not entry.is_dir(follow_symlinks=False) or entry.name.startswith("."):
                continue
            if entry.name in SKIP_DIRS:
                continue
            slug = entry.name
            path = Path(entry.path)
            seen_dirs.add(slug)

            # A topic dir is a KB topic, the inbox, or a dir notes(1) or
            # notes-merge(1) marked as one -- a new topic can have a dir
            # before it has a KB file.
            root_session = read_session(path)
            is_topic = (slug in topics or slug == INBOX
                        or root_session.get("kind") == "topic"
                        or (root_session.get("absorbed")
                            and root_session.get("topic") == slug))
            if not is_topic:
                row(slug, path, "dir")
                continue

            # A topic dir: its root is one row, each investigation another.
            # Not every subdir is an investigation -- `scripts/` and `docs/`
            # belong to the root -- so a subdir counts only when notes-merge
            # recorded it or it has its own .session.json. The Scratch line's
            # subdir list is no help here: it names `scripts/` too.
            row(slug, path, "topic", parent=slug)
            absorbed = {a.get("subdir") or a.get("slug"): a
                        for a in root_session.get("absorbed", [])}
            listed = set(topics.get(slug, {}).get("subdirs", []))
            for sub in sorted(os.scandir(path), key=lambda e: e.name):
                if not sub.is_dir(follow_symlinks=False) or sub.name.startswith("."):
                    continue
                subpath = Path(sub.path)
                if not (sub.name in absorbed
                        or (subpath / ".session.json").is_file()):
                    continue
                rel = "{}/{}".format(slug, sub.name)
                seen_dirs.add(rel)
                row(rel, subpath, "investigation", parent=slug,
                    absorbed_as=absorbed.get(sub.name), listed=sub.name in listed)

    missing = sorted({d for d in dir_topic if d not in seen_dirs})

    return {
        "notes_dir": str(NOTES_DIR),
        "notes_kb": str(NOTES_KB),
        "generated": int(now),
        "topics": topics,
        "dirs": dirs,
        "missing_scratch": missing,
    }


def emit_fzf(index):
    """Rows for the picker. Dir rows first (most recent first), then topic rows.

    Selecting a topic row means "start a new investigation in this topic" --
    the caller supplies the name from the query. A dir row is opened as is:
    `<topic>/` is the topic dir itself, `<topic>/<slug>` one investigation."""
    dirs = sorted(index["dirs"], key=lambda d: -d["last_activity"])
    topics = index["topics"]

    # Cap the columns: one outlier slug (investigate-ingestion-for-5NoiPU...)
    # is 47 chars and would push every other column off the screen.
    def cap(values, lo, hi):
        return max(lo, min(hi, max(values, default=lo)))

    def label(d):
        return d["slug"] + "/" if d["kind"] == "topic" else d["slug"]

    width = cap([len(label(d)) for d in dirs], 20, 40)
    twidth = cap([len(s) for s in topics], 16, 26)

    def elide(text, limit):
        text = re.sub(r"\s+", " ", strip_markup(str(text))).strip()
        return text if len(text) <= limit else text[: limit - 1] + "\u2026"

    def alias_column(topic_slugs):
        """Aliases of the attached topics, minus anything already on the line."""
        out, seen = [], set()
        for t in topic_slugs:
            for a in topics.get(t, {}).get("aliases", []):
                key = a.lower()
                if key in seen or key in {s.lower() for s in topic_slugs}:
                    continue
                seen.add(key)
                out.append(a)
        return ", ".join(out)

    rows = []
    for d in dirs:
        topic = d["topic"] or "-"
        extra = len(d["topics"]) - 1
        if extra > 0:
            topic = "{} +{}".format(elide(topic, twidth - 3), extra)
        state = "" if d["wrapped"] else "UNWRAPPED"
        if d["empty"] and not d["transcripts"]:
            state = "empty"
        if d["kind"] == "topic":
            state = "[dir]"
        note = d["question"] or topics.get(d["topic"], {}).get("hook", "")
        # Former names go in the alias column: after a merge, searching for the
        # old dir name still has to find where the work went.
        aliases = alias_column(d["topics"])
        # An investigation carries its own former name; a topic dir's root
        # only those that did not land in a subdir of their own.
        if d["kind"] == "investigation":
            absorbed = d["absorbed_as"]
        else:
            subs = {x["name"] for x in index["dirs"] if x["parent"] == d["slug"]
                    and x["kind"] == "investigation"}
            absorbed = ", ".join(a.get("slug", "") for a in d["absorbed"]
                                 if (a.get("subdir") or a.get("slug")) not in subs)
        if absorbed:
            aliases = "was: {}{}".format(absorbed, "; " + aliases if aliases else "")
        display = "  {:<{w}}  {:<{t}}  {:>5}  {:<9}  {:<46}  {}".format(
            elide(label(d), width), elide(topic, twidth), d["age"], state,
            elide(note, 46), elide(aliases, 40),
            w=width, t=twidth,
        )
        rows.append((display.rstrip(), d["slug"]))

    for slug in sorted(topics):
        t = topics[slug]
        display = "+ {:<{w}}  {:<{t}}  {:>5}  {:<9}  {:<46}  {}".format(
            "new investigation", elide(slug, twidth), "", "[topic]",
            elide(t["hook"], 46), elide(alias_column([slug]), 40),
            w=width, t=twidth,
        )
        rows.append((display.rstrip(), "+topic:" + slug))

    for display, value in rows:
        print("{}\t{}".format(display, value))


def emit_redirects(index):
    """`<old-slug>\t<current-path>` for every absorbed dir, so the shell can
    send an old name straight to where the work went: the investigation it
    became when there is one, otherwise the dir that absorbed it."""
    became = {(d["parent"], d["absorbed_as"]): d["slug"]
              for d in index["dirs"] if d["absorbed_as"]}
    for d in index["dirs"]:
        for a in d["absorbed"]:
            slug = a.get("slug")
            if slug:
                print("{}\t{}".format(slug, became.get((d["slug"], slug), d["slug"])))


def emit_clusters(index):
    """Candidate merges: scratch dirs that share a knowledge base topic.

    A seed for notes-merge(1), not a verdict. The KB topic is the natural
    target name -- it is already the durable subject, and merging into it makes
    `_notes/` and `topics/` share one namespace. Dirs with no topic are listed
    separately: they may belong to a cluster, but nothing here can say which."""
    by_topic = {}
    unrouted = []
    for d in index["dirs"]:
        # Only top-level dirs are merge candidates: the rest already live in
        # their topic.
        if d["kind"] != "dir":
            continue
        if not d["topics"]:
            if d["files"] or d["transcripts"]:
                unrouted.append(d["slug"])
            continue
        for topic in d["topics"]:
            by_topic.setdefault(topic, []).append(d["slug"])

    clusters = []
    for topic in sorted(by_topic):
        members = sorted(set(by_topic[topic]))
        if len(members) < 2:
            continue
        # A dir feeding several topics must not be merged on this evidence
        # alone -- mp-in-udl feeds four, and belongs to none of them alone.
        shared = sorted(
            m for m in members
            if len(next(d for d in index["dirs"] if d["slug"] == m)["topics"]) > 1
        )
        clusters.append({
            "topic": topic,
            "members": members,
            "target_exists": any(d["slug"] == topic for d in index["dirs"]),
            "ambiguous_members": shared,
        })

    clusters.sort(key=lambda c: -len(c["members"]))
    json.dump({"clusters": clusters, "unrouted": sorted(unrouted)},
              sys.stdout, indent=2)
    sys.stdout.write("\n")


def main():
    args = sys.argv[1:]
    mode = args[0] if args else "--json"
    index = build()
    if mode == "--fzf":
        emit_fzf(index)
    elif mode == "--redirects":
        emit_redirects(index)
    elif mode == "--clusters":
        emit_clusters(index)
    elif mode == "--json":
        json.dump(index, sys.stdout, indent=2)
        sys.stdout.write("\n")
    else:
        sys.stderr.write(__doc__)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
