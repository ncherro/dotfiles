#!/usr/bin/env zsh
# review-agent-hook — tell a PR review's tmux window what its agent is doing.
#
# Claude Code runs this from its hooks in ~/.claude/settings.json:
#   UserPromptSubmit   review-agent-hook busy
#   Stop               review-agent-hook idle
# Outside a review dir, or outside tmux, it does nothing, so the hooks can be
# global rather than repeated in every review dir.
#
# idle shows what is known locally at once -- ready, when /review-pr has just
# recorded its findings -- then asks GitHub in the background, so the label
# catches up with a draft you just posted without holding the agent up. It
# also records when, so an automatic re-review only reuses an agent that has
# sat idle a while, and says when one of those has finished.

[[ -n "$TMUX_PANE" && -f .review-meta.json ]] || exit 0
source "${DOTFILES:-$HOME/Projects/dotfiles}/zsh/tmux-workflows.zsh" 2>/dev/null

window=$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null) || exit 0
state=$(tmux show-options -wqv -t "$window" @review_state)
flags=$(tmux show-options -wqv -t "$window" @review_flags)

case "$1" in
  busy)
    tmux set-option -w -t "$window" @review_agent busy
    _review_apply_state "$window" "$state" "$flags"
    ;;
  idle)
    tmux set-option -w -t "$window" @review_agent idle
    tmux set-option -w -t "$window" @review_agent_idle_at "$EPOCHSECONDS"
    jq -e '.ready_at // empty' .review-meta.json &>/dev/null && state=ready
    _review_apply_state "$window" "$state" "$flags"

    # An automatic re-review (see _review_launch) is done once its agent
    # first goes idle. /review-pr records what it drafted next to ready_at.
    if jq -e '.auto_kind // empty' .review-meta.json &>/dev/null; then
      IFS=$'\t' read -r ready findings replies < <(jq -r \
        '[.ready_at // "-", .ready_findings // 0, .ready_replies // 0] | @tsv' .review-meta.json)
      if [[ "$ready" == "-" ]]; then
        msg="Re-reviewed: nothing new to post"
      else
        msg="Re-reviewed: ${findings} findings, ${replies} replies to post"
      fi
      _review_window_name "$PWD"
      osascript -e 'on run argv' \
        -e 'display notification (item 1 of argv) with title (item 2 of argv)' \
        -e 'end run' "$msg" "$REPLY" &>/dev/null
      tmp=$(jq 'del(.auto_kind, .auto_started_at)' .review-meta.json) \
        && printf '%s\n' "$tmp" > .review-meta.json
    fi
    {
      _review_dir_host "$PWD"
      login=$(GH_HOST="$REPLY" gh api user --jq '.login' 2>/dev/null)
      IFS=$'\t' read -r state _ flags _ <<< "$(_review_probe "$PWD" "$login")"
      [[ -n "$state" ]] && _review_apply_state "$window" "$state" "$flags"
    } </dev/null &>/dev/null &!
    ;;
esac
exit 0
