#!/usr/bin/env bash
# tmux-sessions — the session list, in columns that line up.
#
# Usage:
#   tmux-sessions          aligned list, newest first   (this is what `tls` runs)
#   tmux-sessions --pick   fzf picker in a popup        (this is what `prefix + s` runs)
#   tmux-sessions --rows   the picker's raw rows, for its own reload bindings
#
# Why not `choose-tree -F`: that format is only the text *after* a fixed
# "<session name>: " label, so the name prints twice and every column starts at
# a different offset. There is no way to align it. A popup running this gets
# the same list as `tls` outside tmux, which is the point.
#
# Session names are <repo>--<user>-<branch> or notes--<slug>, so the left two
# thirds of every line is the same text repeated. Tag the kind, strip the
# prefix, and spend the width on what differs.
#
# Sessions are grouped by knowledge base topic: an investigation's notes
# session first, then the coding sessions `code` started from it, found
# through the worktree's .notes-link. Groups sort by their newest activity.
# Names are left alone -- tat, gwt, code and resume all derive a worktree's
# session name from repo and branch, and must keep agreeing on it.
#
# The patterns are derived rather than written down: the repo is whatever
# precedes the first "--" (every name is built that way by
# _tmux_session_name), and the branch prefix is your own username. Nothing
# here needs editing on another machine, and no repo or user name is baked
# into a file that gets pushed.

set -uo pipefail

ME=$(id -un)
NAME_WIDTH=44
TOPIC_WIDTH=24
NOTES_DIR="${NOTES_DIR:-$HOME/workspace/_notes}"
NOTES_KB="${NOTES_KB:-$HOME/workspace/notes-kb}"
NOTES_INBOX="${NOTES_INBOX:-inbox}"
# Sessions the picker opens with their windows already expanded, space
# separated. ctrl-o still collapses them.
TMUX_SESSIONS_EXPANDED="${TMUX_SESSIONS_EXPANDED:-pr-reviews}"
# The PR review session, and the state review-status last saw for every
# review in it (see _review_write_status_cache).
REVIEW_SESSION=pr-reviews
REVIEWS_DIR="${REVIEWS_DIR:-$HOME/workspace/_reviews}"
REVIEW_CACHE="$REVIEWS_DIR/.status.tsv"
WORKFLOWS_ZSH="$(cd "$(dirname "$0")/.." && pwd)/zsh/tmux-workflows.zsh"

# A field of a .session.json, without paying for jq on every popup.
session_field() {
  [ -f "$1/.session.json" ] || return 0
  sed -n 's/^ *"'"$2"'": *"\([^"]*\)".*/\1/p' "$1/.session.json" | head -1
}

# The topic a notes dir belongs to: the topic dir it is (or is in), else what
# where /wrap said it should go, else what its metadata says.
topic_of_notes_dir() {
  local dir="$1" rel top t
  rel="${dir#"$NOTES_DIR"/}"
  [ "$rel" = "$dir" ] && return 0
  top="${rel%%/*}"
  if [ "$top" != "$NOTES_INBOX" ] && { [ -f "$NOTES_KB/topics/$top.md" ] \
       || [ "$(session_field "$NOTES_DIR/$top" kind)" = topic ]; }; then
    printf '%s' "$top"; return
  fi
  # A move /wrap recorded is where it is headed, so it wins.
  t=$(session_field "$dir" move_to)
  [ -n "$t" ] || t=$(session_field "$dir" topic)
  printf '%s' "$t"
}

topic_of_session() {
  local sess="$1" path="$2" link
  case "$sess" in
    notes--*) topic_of_notes_dir "$NOTES_DIR/${sess#notes--}" ;;
    pr-*)     ;;
    *)
      link="$path/.notes-link"
      [ -f "$link" ] && topic_of_notes_dir "$(head -1 "$link")"
      ;;
  esac
}

# <repo>--<branch> -> <branch>, then drop your own branch prefix. Parameter
# expansion rather than a regex: the repo name contains dashes itself, so
# "up to the first --" is the boundary, and no pattern for that is readable.
shorten() {
  local n="${1#*--}"
  n="${n#"$ME"-}"
  printf '%s' "${n#"$ME"/}"
}

# Claude Code sets its process title to its version, so a pane running it
# reports "2.1.295" as its command. Show what it is instead.
CLAUDE_VERSION='s/^[0-9]+\.[0-9]+\.[0-9]+$/claude/'

# Where a review sorts among its session's windows: what needs you first,
# finished ones last. Into RANK.
review_rank() {
  case "$1" in
    attention) RANK=0  ;; your-turn) RANK=1 ;; ready)     RANK=2 ;;
    updated)   RANK=3  ;; pending)   RANK=4 ;; reviewing) RANK=5 ;;
    open)      RANK=6  ;; commented) RANK=8 ;; approved)  RANK=9 ;;
    merged)    RANK=10 ;; closed)    RANK=11 ;; *)        RANK=7 ;;
  esac
}

# A session's windows, one line each: rank, index, icon, label, name, active,
# command, target. A window that is not a review ranks -1, keeping its place
# at the top. In pr-reviews the reviews with no window follow every window
# (rank + 20), from what review-status last saw, with "@<dir>" for an index.
#
# A PR review window carries its state (see _review_apply_state). "-" stands
# in for an empty field: read(1) collapses a run of tabs, so one cannot be
# empty.
window_items() {
  local sess="$1" idx name active cmd shown icon label dir state flags url
  local windowed=" "
  while IFS=$'\t' read -r idx name active cmd shown icon label dir; do
    if [ "$dir" = "-" ]; then
      RANK=-1
    else
      review_rank "$shown"
      windowed+="$dir "
    fi
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$RANK" "$idx" "$icon" "$label" "$name" "$active" "$cmd" "$sess:$idx"
  done < <(tmux list-windows -t "=$sess" -F '#{window_index}	#{window_name}	#{window_active}	#{pane_current_command}	#{?@review_shown,#{@review_shown},#{?@review_state,#{@review_state},-}}	#{?@review_icon,#{@review_icon},-}	#{?@review_label,#{@review_label},-}	#{?@review,#{@review},-}' 2>/dev/null)

  [ "$sess" = "$REVIEW_SESSION" ] && [ -f "$REVIEW_CACHE" ] || return 0
  while IFS=$'\t' read -r state dir flags name icon label url; do
    case "$windowed" in *" $dir "*) continue ;; esac
    # Removed by review-gc since review-status last looked.
    [ -d "$REVIEWS_DIR/$dir" ] || continue
    review_rank "$state"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$((RANK + 20))" "@$dir" "$icon" "$label" "$name" 0 - "$sess:@$dir"
  done < "$REVIEW_CACHE"
}

# The review states in a session as counts, in rank order: "✉1 ●4 ✓2".
review_counts() {
  window_items "$1" | awk -F'\t' '
      $1 >= 0 && $3 != "-" {
        r = $1 % 20; n[$3]++
        if (!($3 in best) || r < best[$3]) best[$3] = r }
      END { for (i in n) print best[i] "\t" i n[i] }' \
    | sort -n | cut -f2 | tr '\n' ' '
}

# Pad to a width in characters. printf pads by bytes, and the icons are three
# each.
pad() {
  local s="$1" n=$(($2 - ${#1}))
  [ $n -gt 0 ] && printf -v s '%s%*s' "$s" "$n" ""
  printf '%s' "$s"
}

# One indented row per window of a session, under its name column. The hidden
# field is <session>:<index>, which the picker tells apart from a session by
# the colon (tmux never allows one in a session name). A review with no window
# is dimmed, and its index is "@<dir>": choosing it opens a window for it.
window_rows() {
  local rank idx icon label name active cmd target mark dim off
  window_items "$1" | sort -t$'\t' -k1,1n -k2,2n \
    | while IFS=$'\t' read -r rank idx icon label name active cmd target; do
        [ "$active" = 1 ] && mark="*" || mark="·"
        [ "$label" = "-" ] && label=
        case "$cmd" in zsh|bash|sh|login|-) cmd= ;; esac
        cmd=$(printf '%s' "$cmd" | sed -E "$CLAUDE_VERSION")
        # tmux names a window after its command unless told otherwise.
        name=$(printf '%s' "$name" | sed -E "$CLAUDE_VERSION")
        [ "$icon" != "-" ] && name="$icon $name"
        dim= off=
        case "$idx" in
          @*) mark=" " idx="-" dim=$'\033[2m' off=$'\033[0m' ;;
        esac
        name="$idx: $name"
        [ ${#name} -gt $((NAME_WIDTH - 2)) ] && name="${name:0:$((NAME_WIDTH - 3))}…"
        # 12 columns stand in for the session row's window count and age, so
        # the command lines up with the session's process column.
        printf '%s %s%-5s %-*s %s %s %s %s%s\t%s\n' \
          " " "$dim" "" "$TOPIC_WIDTH" "" "$mark" "$(pad "$name" $((NAME_WIDTH - 2)))" \
          "$(pad "$label" 12)" "$cmd" "$off" "$target"
      done
}

# The picker keeps the sessions you expanded, one name per line, in a scratch
# dir it shares with its own bindings through this variable.
OPEN_FILE="${TMUX_SESSIONS_STATE:+$TMUX_SESSIONS_STATE/open}"

is_open() {
  [ -n "$OPEN_FILE" ] && [ -f "$OPEN_FILE" ] && grep -qxF -- "$1" "$OPEN_FILE"
}

rows() {
  local ts att wins when sess path tag short procs topic rank
  # Pass 1: one line per session with its topic, keyed for grouping.
  tmux ls -F '#{session_activity}	#{?session_attached,*,-}	#{session_windows}	#{t/p:session_activity}	#{session_name}	#{session_path}' 2>/dev/null \
    | while IFS=$'\t' read -r ts att wins when sess path; do
        topic=$(topic_of_session "$sess" "$path")
        # The notes session leads its group; a session with no topic is a
        # group of one, keyed by its own name.
        case "$sess" in notes--*) rank=0 ;; *) rank=1 ;; esac
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
          "${topic:-=$sess}" "$rank" "$ts" "$att" "$wins" "$when" "$sess" "$topic"
      done \
    | awk -F'\t' '
        # Each group sorts by its newest member, then members by rank and age.
        { line[NR] = $0; if ($3 > newest[$1]) newest[$1] = $3 }
        END { for (i = 1; i <= NR; i++) {
                split(line[i], f, "\t"); print newest[f[1]] "\t" line[i] } }' \
    | sort -t$'\t' -k1,1nr -k2,2 -k3,3n -k4,4nr \
    | cut -f4- \
    | while IFS=$'\t' read -r ts att wins when sess topic; do
        [ "$att" = "-" ] && att=" "
        case "$sess" in
          notes--*)    tag=notes ;;
          pr-*)        tag=pr    ;;
          *)           tag=wt    ;;
        esac
        short=$(shorten "$sess")
        procs=$(tmux list-windows -t "=$sess" -F '#{pane_current_command}' 2>/dev/null \
          | grep -vE '^(zsh|bash|sh|login)$' | sed -E "$CLAUDE_VERSION" \
          | sort -u | tr '\n' ' ')
        # The review session says where its reviews stand instead.
        [ "$sess" = "$REVIEW_SESSION" ] && procs=$(review_counts "$sess")
        [ ${#topic} -gt $TOPIC_WIDTH ] && topic="${topic:0:$((TOPIC_WIDTH - 1))}…"
        # Display, then the real name hidden behind a tab for the picker.
        printf '%s %-5s %-*s %-*s %2sw  %-5s  %s\t%s\n' \
          "$att" "$tag" "$TOPIC_WIDTH" "${topic:--}" "$NAME_WIDTH" "$short" \
          "$wins" "$when" "$procs" "$sess"
        is_open "$sess" && window_rows "$sess"
      done
}

case "${1:-}" in
  --rows) rows ;;

  # ctrl-o / alt-o in the picker: expand or collapse the highlighted session
  # (a window row stands for its session), or all of them. Writes the new rows
  # for the reload, and where the cursor should land once they are loaded --
  # fzf 0.55 cannot keep it on the same item across a reload by itself.
  --toggle|--toggle-all)
    [ -n "$OPEN_FILE" ] || exit 1
    touch "$OPEN_FILE"
    sess="${2%%:*}"
    if [ "$1" = --toggle-all ]; then
      if [ -s "$OPEN_FILE" ]; then
        : > "$OPEN_FILE"
      else
        tmux ls -F '#{session_name}' > "$OPEN_FILE"
      fi
    elif is_open "$sess"; then
      grep -vxF -- "$sess" "$OPEN_FILE" > "$OPEN_FILE.new"
      mv "$OPEN_FILE.new" "$OPEN_FILE"
    else
      printf '%s\n' "$sess" >> "$OPEN_FILE"
    fi
    rows > "$TMUX_SESSIONS_STATE/rows"
    n=$(cut -f2 "$TMUX_SESSIONS_STATE/rows" | grep -nxF -- "$sess" | cut -d: -f1)
    [ -n "$n" ] && echo "pos($n)" > "$TMUX_SESSIONS_STATE/pos"
    ;;

  # ctrl-x in the picker: a <session>:<index> row is a window, the rest are
  # sessions. A review with no window has nothing to kill; review-gc removes
  # the review itself.
  --kill)
    case "$2" in
      *:@*) ;;
      *:*) tmux kill-window -t "=$2" ;;
      *)   tmux kill-session -t "=$2" ;;
    esac
    ;;

  --pick)
    # A popup takes its stderr with it when it closes, so a failure in here is
    # invisible by default. TMUX_SESSIONS_DEBUG=1 keeps a copy.
    if [ -n "${TMUX_SESSIONS_DEBUG:-}" ]; then
      exec 2>>/tmp/tmux-pick.log
      echo "--- $(date +%H:%M:%S) tty=$(tty 2>&1) fzf=$(command -v fzf)" >&2
    fi
    self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
    TMUX_SESSIONS_STATE=$(mktemp -d "${TMPDIR:-/tmp}/tmux-sessions.XXXXXX")
    export TMUX_SESSIONS_STATE
    trap 'rm -rf "$TMUX_SESSIONS_STATE"' EXIT
    state="$TMUX_SESSIONS_STATE"
    # Set at the top before there was a state dir, so this first rows call
    # would not see what is open.
    OPEN_FILE="$state/open"
    for s in $TMUX_SESSIONS_EXPANDED; do
      tmux has-session -t "=$s" 2>/dev/null && printf '%s\n' "$s" >> "$OPEN_FILE"
    done
    pick=$(rows | fzf --ansi --delimiter=$'\t' --with-nth=1 \
                      --reverse --no-sort \
                      --prompt='session> ' \
                      --header='enter: switch · ctrl-o: windows · alt-o: all windows · ctrl-x: kill' \
                      --bind "ctrl-o:execute-silent($self --toggle {2})+reload(cat '$state/rows')" \
                      --bind "alt-o:execute-silent($self --toggle-all {2})+reload(cat '$state/rows')" \
                      --bind "load:transform(cat '$state/pos' 2>/dev/null; rm -f '$state/pos')" \
                      --bind "ctrl-x:execute-silent($self --kill {2})+reload($self --rows)")
    [ -n "${TMUX_SESSIONS_DEBUG:-}" ] && echo "    fzf exit=$? pick=${pick:-<empty>}" >&2
    [ -n "$pick" ] || exit 0
    target="${pick##*$'\t'}"
    sess="${target%%:*}"
    # A review with no window: open one, through the same function
    # review-status --windows uses, and go to it.
    case "$target" in
      *:@*)
        idx=$(zsh -c 'source "$1" 2>/dev/null; _review_open_window "$2"; print -r -- "$REPLY"' \
          _ "$WORKFLOWS_ZSH" "${target#*:@}")
        target="$sess${idx:+:$idx}"
        ;;
    esac
    # A window row: make it the session's current window, then switch to the
    # session as usual.
    [ "$target" != "$sess" ] && tmux select-window -t "=$target"
    if [ -n "${TMUX:-}" ]; then
      tmux switch-client -t "=$sess"
    else
      tmux attach-session -t "=$sess"
    fi
    ;;

  *)
    out=$(rows)
    if [ -z "$out" ]; then
      echo "no tmux sessions — 'resume' reopens what you were working on"
      exit 0
    fi
    # Drop the hidden name field (only the picker needs it) and the trailing
    # blanks left by sessions with nothing running.
    printf '%s\n' "$out" | cut -d$'\t' -f1 | sed 's/ *$//'
    ;;
esac
